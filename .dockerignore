# Keep the build context small and free of secrets. `az acr build` uploads
# everything not listed here to Azure.
.git
.gitattributes
.gitignore
.DS_Store
.venv
**/.venv
**/__pycache__
**/*.pyc
.ruff_cache
.pytest_cache
.worktrees
.superpowers
.vscode

# Holds a hardcoded Azure key.
playground/

samples/
docs/
dev.sh
AGENTS.md
README.md

backend/.env
backend/data/
backend/json_extracted/
backend/test.py
backend/scripts/

frontend/node_modules/
frontend/dist/
frontend/.env
